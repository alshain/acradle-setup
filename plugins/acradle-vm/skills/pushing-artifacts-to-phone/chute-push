#!/usr/bin/env bash
# chute-push — send an artifact to the user's phone via chute.
#
#   chute-push --stream <name> [--version NAME] [--notes TEXT] [--wait SECONDS] <file>
#   chute-push --stream <name> --set <dir> [--items <tsv>] [--cover NAME]
#              [--type EXT=MIME]... [--name <file.zip>] [--version NAME]
#              [--notes TEXT] [--wait SECONDS]
#
# Pairs on first use (phone approval; code printed loudly and persisted so a
# re-run resumes the same code). Token: ~/.config/chute/token.
#
# --set pushes the top-level files of <dir> as ONE chute artifact set (one
# notification, one gallery on the phone). The zip is built by chute-set.py
# (next to this script; needs python3, stdlib only) BEFORE any pairing or
# network, so a bad set never costs a phone tap. --items is a TSV of
# filename<TAB>title<TAB>description (row order = display order); --cover
# puts one file first; --notes describes the whole set.
#
# Exit codes: 0 success, 2 usage, 3 (--set only) your inputs were rejected
# locally and nothing was sent — fix them and re-run, 1 anything else.
set -euo pipefail

CHUTE_URL="${CHUTE_URL:-https://chute.vqrs.ch}"
CHUTE_PRISON_ORG="${CHUTE_PRISON_ORG:-alshains-prison}"
CHUTE_SELF_OWNER="${CHUTE_SELF_OWNER:-alshain}"
CONFIG_DIR="${HOME}/.config/chute"
TOKEN_FILE="${CONFIG_DIR}/token"
PENDING_FILE="${CONFIG_DIR}/pending-pairing"
POLL_INTERVAL=10

STREAM="" VERSION="" NOTES="" FILE="" WAIT=300
SET_DIR="" ITEMS="" COVER="" NAME="" SET_ONLY=0
TYPES=()

die() { echo "chute-push: $*" >&2; exit 1; }
reject() { echo "chute-push: $*" >&2; exit 3; }   # --set inputs refused; nothing sent

usage() {
  [ "$#" -eq 0 ] || echo "chute-push: $*" >&2
  echo "usage: chute-push --stream <name> [--version NAME] [--notes TEXT] [--wait SECONDS] <file>" >&2
  echo "       chute-push --stream <name> --set <dir> [--items <tsv>] [--cover NAME] [--type EXT=MIME]..." >&2
  echo "                  [--name <file.zip>] [--version NAME] [--notes TEXT] [--wait SECONDS]" >&2
  exit 2
}

need_val() { [ "$#" -ge 2 ] || die "flag $1 needs a value"; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --stream)  need_val "$@"; STREAM="$2";  shift 2 ;;
    --version) need_val "$@"; VERSION="$2"; shift 2 ;;
    --notes)   need_val "$@"; NOTES="$2";   shift 2 ;;
    --wait)    need_val "$@"; WAIT="$2";    shift 2 ;;
    --set)     need_val "$@"; SET_DIR="$2"; shift 2 ;;
    --items)   need_val "$@"; ITEMS="$2";   SET_ONLY=1; shift 2 ;;
    --cover)   need_val "$@"; COVER="$2";   SET_ONLY=1; shift 2 ;;
    --type)    need_val "$@"; TYPES+=(--type "$2"); SET_ONLY=1; shift 2 ;;
    --name)    need_val "$@"; NAME="$2";    SET_ONLY=1; shift 2 ;;
    -h|--help) usage ;;
    -*)        die "unknown flag: $1" ;;
    *)         [ -z "$FILE" ] || usage; FILE="$1"; shift ;;
  esac
done

[ -n "$STREAM" ] || usage
if [ -n "$SET_DIR" ]; then
  [ -z "$FILE" ] || usage "--set takes a directory, not a file as well"
  [ -d "$SET_DIR" ] || reject "--set: not a directory: $SET_DIR"
  [ -n "$NAME" ] || NAME="$(basename "$(cd "$SET_DIR" && pwd)").zip"
  case "$NAME" in */*|*\\*) usage "--name must be a file name, not a path" ;; esac
  # The server runs its APK parser first and exclusively for an .apk name
  # (chute internal/api/upload.go), so a set named that way is rejected.
  case "${NAME,,}" in
    *.apk) usage "a set must not be named .apk: the server would run its APK parser first" ;;
  esac
else
  [ "$SET_ONLY" = 0 ] || usage "--items, --cover, --type and --name need --set"
  [ -n "$FILE" ] || usage
  [ -r "$FILE" ] || die "cannot read file: $FILE"
fi

TMP="$(mktemp)"
SET_TMP=""
trap 'rm -f "$TMP"; if [ -n "$SET_TMP" ]; then rm -rf "$SET_TMP"; fi' EXIT

# Build the set before anything touches the network: a rejected input costs
# no pairing and no upload. chute-set.py exits 3 for inputs it refuses (its
# message names the file and the rule), 2 for usage, 1 for a bug or I/O.
if [ -n "$SET_DIR" ]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  command -v python3 >/dev/null 2>&1 \
    || die "--set needs python3 (present on acradle guests); single-file pushes still work"
  SET_TMP="$(mktemp -d)"
  FILE="$SET_TMP/$NAME"
  build_args=(--out "$FILE")
  if [ -n "$ITEMS" ]; then build_args+=(--items "$ITEMS"); fi
  if [ -n "$COVER" ]; then build_args+=(--cover "$COVER"); fi
  build_args+=("${TYPES[@]}" "$SET_DIR")
  brc=0; python3 "$SCRIPT_DIR/chute-set.py" "${build_args[@]}" || brc=$?
  case "$brc" in
    0) ;;
    2|3) exit "$brc" ;;
    *) die "building the set failed (chute-set.py exit $brc); nothing was sent" ;;
  esac
  max="${CHUTE_MAX_UPLOAD_BYTES:-536870912}"
  size="$(wc -c < "$FILE" | tr -d ' ')"
  if [ "$size" -gt "$max" ]; then
    reject "the set archive is $size bytes, over the upload cap of $max bytes (CHUTE_MAX_UPLOAD_BYTES); nothing was sent
hint: split the files into several sets"
  fi
fi

# Percent-encode a string byte-wise (LC_ALL=C makes ${s:i:1} a byte, so
# UTF-8 comes out as %XX%XX... — required for query parameters like notes).
urlencode() {
  local LC_ALL=C s="$1" out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+="$(printf '%%%02X' "'$c")" ;;
    esac
  done
  printf '%s' "$out"
}

json_escape() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }

# First string value for a key in compact Go-marshaled JSON: "key":"value".
json_field() {
  printf '%s' "$1" | grep -o "\"$2\":\"[^\"]*\"" | head -n1 | sed 's/^"[^"]*":"//; s/"$//'
}

# First non-negative integer value for a key: "key":123. Empty when absent.
json_num() {
  printf '%s' "$1" | { grep -o "\"$2\":[0-9]*" || true; } | head -n1 | sed 's/^"[^"]*"://'
}

# The one owner of the chute:// deep-link format in this language (chute's
# docs/deep-links.md; the Kotlin side is ChuteLink). Emits finished markdown so
# the agent relays a line verbatim rather than composing a URL — and so the raw
# chute:// string is never shown to the user. Nothing else in this script may
# write a chute:// string.
#   deep_link version ID   -> [Open](...) · [Install](...)
#   deep_link set ID       -> [Open](...) · [Gallery](chute://set/ID)
#   deep_link approvals    -> [Approve on phone](chute://approvals)
deep_link() {
  case "$1" in
    version)
      printf '[Open](chute://version/%s) · [Install](chute://version/%s?action=install)' "$2" "$2" ;;
    set)
      printf '[Open](chute://version/%s) · [Gallery](chute://set/%s)' "$2" "$2" ;;
    approvals)
      printf '[Approve on phone](chute://approvals)' ;;
    *) die "deep_link: unknown kind '$1'" ;;
  esac
}

# GitHub fork-parent lookup using the credential already in git's store.
# Prints "owner/name" of the parent, or nothing (rc 1) when unavailable.
fork_parent() {
  local cred pass resp
  cred="$(printf 'protocol=https\nhost=github.com\n\n' \
    | GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true git credential fill 2>/dev/null)" || return 1
  pass="$(printf '%s\n' "$cred" | sed -n 's/^password=//p' | head -n1)"
  [ -n "$pass" ] || return 1
  resp="$(curl -fsS --max-time 10 -H "Authorization: Bearer $pass" \
    "https://api.github.com/repos/$1/$2")" || return 1
  # parent's full_name precedes any nested object inside "parent":{...}
  printf '%s' "$resp" \
    | grep -o '"parent":{[^{]*"full_name":"[^"]*"' \
    | grep -o '"full_name":"[^"]*"' | head -n1 \
    | sed 's/^"full_name":"//; s/"$//'
}

# Proposed project name (pairing only — spec: lazy, zero lookups when a
# token already exists). Prison repos normalize to their upstream identity.
derive_project() {
  local url path owner name parent
  url="$(git remote get-url origin 2>/dev/null || true)"
  if [ -z "$url" ]; then basename "$PWD"; return; fi
  path="${url%.git}"
  case "$path" in
    git@*:*)    path="${path#*:}" ;;
    ssh://*)    path="${path#ssh://}"; path="${path#*/}" ;;
    http://*|https://*) path="${path#*://}"; path="${path#*/}" ;;
  esac
  owner="${path%%/*}"; name="${path#*/}"
  if [ -z "$owner" ] || [ -z "$name" ] || [ "$owner" = "$path" ]; then
    basename "$PWD"; return
  fi
  if [ "$owner" = "$CHUTE_PRISON_ORG" ]; then
    parent="$(fork_parent "$owner" "$name" || true)"
    if [ -n "$parent" ]; then
      owner="${parent%%/*}"; name="${parent#*/}"
    else
      # Seeded prisons aren't forks; fall back to name parsing.
      case "$name" in
        "$CHUTE_SELF_OWNER"-*) printf '%s\n' "${name#"$CHUTE_SELF_OWNER"-}"; return ;;
        *-*)                   printf '%s/%s\n' "${name%%-*}" "${name#*-}"; return ;;
        *)                     printf '%s\n' "$name"; return ;;
      esac
    fi
  fi
  if [ "$owner" = "$CHUTE_SELF_OWNER" ]; then
    printf '%s\n' "$name"
  else
    printf '%s/%s\n' "$owner" "$name"
  fi
}

pair() {
  local code secret resp http project waited tok
  mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR"
  if [ -s "$PENDING_FILE" ]; then
    code="$(sed -n '1p' "$PENDING_FILE")"
    secret="$(sed -n '2p' "$PENDING_FILE")"
    echo "chute-push: resuming pending pairing"
  else
    project="$(derive_project)"
    echo "chute-push: requesting pairing for project '$project'"
    http="$(curl -sS --max-time 15 -o "$TMP" -w '%{http_code}' \
      -X POST -H 'Content-Type: application/json' \
      -d "{\"proposed_name\":\"$(json_escape "$project")\"}" \
      "$CHUTE_URL/v1/pair")" || die "cannot reach chute at $CHUTE_URL"
    [ "$http" = "201" ] || die "pairing request failed (HTTP $http): $(cat "$TMP")"
    resp="$(cat "$TMP")"
    code="$(json_field "$resp" code)"
    secret="$(json_field "$resp" poll_secret)"
    { [ -n "$code" ] && [ -n "$secret" ]; } || die "unexpected pairing response"
    ( umask 077; printf '%s\n%s\n' "$code" "$secret" > "$PENDING_FILE" )
  fi

  echo ""
  echo "==================================================================="
  echo "  PAIRING CODE: $code   (valid 24h)"
  echo "  Approve on the phone — only tap the card showing THIS code."
  echo "  AGENT: relay this code to the user in your reply, verbatim, together"
  echo "         with this link: $(deep_link approvals)"
  echo "==================================================================="
  echo ""

  waited=0
  while [ "$waited" -lt "$WAIT" ]; do
    http="$(curl -sS --max-time 15 -o "$TMP" -w '%{http_code}' \
      -H "X-Chute-Poll-Secret: $secret" "$CHUTE_URL/v1/pair/$code")" || http=000
    case "$http" in
      200)
        tok="$(json_field "$(cat "$TMP")" token)"
        [ -n "$tok" ] || die "approved but no token in response"
        ( umask 077; printf '%s\n' "$tok" > "$TOKEN_FILE" )
        rm -f "$PENDING_FILE"
        echo "chute-push: paired."
        return 0 ;;
      202) : ;;
      401) die "poll secret rejected — remove $PENDING_FILE and re-run" ;;
      403) rm -f "$PENDING_FILE"; die "pairing denied on the phone" ;;
      404|410) rm -f "$PENDING_FILE"; die "pairing expired or already used — re-run to request a new code" ;;
      429) sleep 20; waited=$((waited + 20)) ;;
      000) : ;;
      *) die "unexpected response while polling (HTTP $http): $(cat "$TMP")" ;;
    esac
    sleep "$POLL_INTERVAL"; waited=$((waited + POLL_INTERVAL))
  done
  die "pairing still pending after ${WAIT}s — approve on the phone, then re-run (same code resumes)"
}

# Uploads $FILE. Returns 0 on success, 41 on auth rejection (caller
# re-pairs once); dies on every other failure.
upload() {
  local token qs http branch commit resp vid count shown conformed
  token="$(cat "$TOKEN_FILE")"
  qs="filename=$(urlencode "$(basename "$FILE")")"
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  commit="$(git rev-parse --short HEAD 2>/dev/null || true)"
  if [ -n "$branch" ]; then qs="${qs}&branch=$(urlencode "$branch")"; fi
  if [ -n "$commit" ]; then qs="${qs}&commit=$(urlencode "$commit")"; fi
  if [ -n "$VERSION" ]; then qs="${qs}&version=$(urlencode "$VERSION")"; fi
  if [ -n "$NOTES" ]; then qs="${qs}&notes=$(urlencode "$NOTES")"; fi
  http="$(curl -sS -o "$TMP" -w '%{http_code}' \
    -T "$FILE" -H "Authorization: Bearer $token" \
    "$CHUTE_URL/v1/streams/$(urlencode "$STREAM")/versions?$qs")" \
    || die "upload failed: cannot reach $CHUTE_URL"
  case "$http" in
    201|200)
      resp="$(cat "$TMP")"
      vid="$(json_field "$resp" version_id)"
      count="$(json_num "$resp" set_item_count)"
      if [ -n "$SET_DIR" ] && [ "${count:-0}" -eq 0 ]; then
        # Tripwire A: chute-set.py built a set the server did not recognise.
        die "server stored '$(basename "$FILE")' as a plain artifact, not a set (set_item_count=${count:-0}) — chute-set.py and chute have drifted; report this: $resp"
      fi
      if [ -n "$SET_DIR" ]; then
        shown="set '$(basename "$FILE")' ($count items)"
      else
        shown="'$(basename "$FILE")'"
      fi
      if [ "$http" = "200" ]; then
        if [ -n "$SET_DIR" ]; then
          echo "chute-push: already on the server (idempotent replay): $shown: $resp"
          if [ -n "$VERSION$NOTES" ]; then
            echo "chute-push: --version/--notes were ignored: the server keeps the existing version as it was; only a changed file or caption makes a new version (and a new notification)"
          fi
        else
          echo "chute-push: already on the server (idempotent replay): $resp"
        fi
      else
        echo "chute-push: uploaded $shown to stream '$STREAM': $resp"
      fi
      if [ -n "$vid" ]; then
        echo ""
        echo "DEEP LINKS (relay to the user verbatim, as markdown — never the raw URL):"
        if [ "${count:-0}" -gt 0 ]; then
          echo "  $(deep_link set "$vid")"
        else
          echo "  $(deep_link version "$vid")"
        fi
        echo ""
      fi
      ;;
    400)
      if [ -n "$SET_DIR" ] && grep -qF 'set manifest is invalid' "$TMP"; then
        # Tripwire B: the server's set.Parse refused what chute-set.py's
        # mirror of it accepted. The server reclaimed the blob; no version.
        conformed="$(sed -n 's/^CONFORMED_TO_CHUTE = "\([0-9a-f]*\)".*/\1/p' "$SCRIPT_DIR/chute-set.py")"
        die "upload refused (HTTP 400): $(cat "$TMP")
chute-push: this is a producer bug (chute-set.py disagrees with the server, CONFORMED_TO_CHUTE=${conformed:-unknown}); do not retry the same inputs, report it"
      fi
      die "upload failed (HTTP $http): $(cat "$TMP")" ;;
    401) return 41 ;;
    413) die "file exceeds the server's upload cap" ;;
    *)   die "upload failed (HTTP $http): $(cat "$TMP")" ;;
  esac
}

[ -s "$TOKEN_FILE" ] || pair

rc=0
upload || rc=$?
if [ "$rc" = "41" ]; then
  echo "chute-push: token rejected (revoked or stale) — re-pairing"
  rm -f "$TOKEN_FILE"
  pair
  upload
elif [ "$rc" != "0" ]; then
  exit "$rc"
fi
